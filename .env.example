# Frontend (public — safe to ship in the browser bundle; RLS protects the data)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Backend secrets (set in the Cloud backend secret store — never committed)
# LOVABLE_API_KEY        AI gateway key used by the generation services
# SUPABASE_URL           Injected automatically into edge functions
# SUPABASE_ANON_KEY      Injected automatically into edge functions
# SUPABASE_SERVICE_ROLE_KEY  Injected automatically; server-side only
# ALLOWED_ORIGINS        Optional, comma separated extra CORS origins